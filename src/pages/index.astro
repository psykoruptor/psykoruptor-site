---
import SocialIcon from "../components/SocialIcon.astro";
import { links } from "../config/links";

const enabledLinks = links.filter((link) => link.enabled);

const buttonHeight = 54;
const buttonGap = 15;

const surfaceHeight =
  enabledLinks.length * buttonHeight +
  Math.max(enabledLinks.length - 1, 0) * buttonGap;

// Hauteur originale de bg1 / du masque complet
const originalSurfaceHeight = 468;
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Psykoruptor — Links</title>
  </head>

  <body>
    <main>
      <img class="logo" src="/logotext1.png" alt="Psykoruptor" />

      <div
        class="links"
        style={`--surface-height: ${surfaceHeight}px;`}
      >

        <!--
          Le SVG garde toujours la taille originale de bg1.png.
          On ne redimensionne donc jamais l'image quand un lien
          est activé/désactivé.
        -->
        <div class="button-surface">
          <svg
            viewBox={`0 0 300 ${originalSurfaceHeight}`}
            width="300"
            height={originalSurfaceHeight}
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <defs>
              <mask id="buttonMask" maskUnits="userSpaceOnUse">
                <rect
                  width="300"
                  height={originalSurfaceHeight}
                  fill="black"
                />

                {enabledLinks.map((_, index) => (
                  <rect
                    x="0"
                    y={index * (buttonHeight + buttonGap)}
                    width="300"
                    height={buttonHeight}
                    rx="10"
                    fill="white"
                  />
                ))}
              </mask>
            </defs>

            <image
              href="/bg1.png"
              x="0"
              y="0"
              width="300"
              height={originalSurfaceHeight}
              preserveAspectRatio="none"
              mask="url(#buttonMask)"
            />
          </svg>
        </div>

        {enabledLinks.map((link) => (
          <a href={link.url}>
            <SocialIcon name={link.name} />
            <span>{link.name}</span>
          </a>
        ))}

      </div>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100vh;
    background-image: url("/bg0.png");
    background-size: cover;
    background-position: center;
  }

  main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .logo {
    width: 300px;
    height: auto;
    margin-bottom: 30px;
    filter:
      drop-shadow(0px -0.5px 0.5px white)
      drop-shadow(0px -2px 1.5px white)
      drop-shadow(0px 1px 1px black)
      drop-shadow(0px 2px 3px black)
      drop-shadow(0px 3px 3px black);
  }

  .links {
    position: relative;
    width: 300px;

    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  /*
    Le SVG garde toujours 300x468.

    On coupe simplement ce qui dépasse la hauteur réelle
    des boutons actifs.

    Ainsi bg1.png conserve exactement les mêmes coordonnées
    quelle que soit la quantité de liens affichés.
  */
  .button-surface {
    position: absolute;
    top: 0;
    left: 0;

    width: 300px;
    height: var(--surface-height);

    overflow: hidden;

    pointer-events: none;
    filter: drop-shadow(0px 4px 7px rgba(0, 0, 0, 0.7));
  }

  .button-surface svg {
    display: block;

    width: 300px;
    height: 468px;
  }

  .links a {
    position: relative;
    z-index: 1;

    display: grid;
    grid-template-columns: 24px 1fr 24px;
    align-items: center;

    width: 300px;
    height: 54px;
    padding: 0 15px;
    box-sizing: border-box;

    background: transparent;

    color: white;
    text-decoration: none;

    border-radius: 10px;
  }

  .links a span {
    text-align: center;

    filter:
      drop-shadow(0px -2px 2px white)
      drop-shadow(0px 2px 2px black);
  }
</style>