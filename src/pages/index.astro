```astro
---
import SocialIcon from "../components/SocialIcon.astro";
import {
  links,
  buttonWidth,
  buttonHeight,
  buttonGap,
  iconMargin,
  fireColor,
} from "../config/links";
import { fireShadow0, fireShadow1 } from "../config/styles";

const enabledLinks = links.filter((link) => link.enabled);

const surfaceHeight =
  enabledLinks.length * buttonHeight +
  Math.max(enabledLinks.length - 1, 0) * buttonGap;

const backgroundWidth = 300;
const backgroundHeight = 468;
---

<html
  lang="fr"
  style={`--fire-shadow-0: ${fireShadow0}; --fire-shadow-1: ${fireShadow1};`}
>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Psykoruptor — Links</title>
    <link rel="icon" type="image/png" href="/icon0.png" />

    <!-- Préchargement des images principales -->
    <link
      rel="preload"
      as="image"
      href="/bg0.png"
      fetchpriority="high"
    />
    <link rel="preload" as="image" href="/bg1.png" />

    <!-- API du lecteur SoundCloud -->
    <script is:inline src="https://w.soundcloud.com/player/api.js"></script>
  </head>

  <body>
    <main>
      <img
        class="logo"
        src="/logotext1.png"
        alt="Psykoruptor"
        style={{ filter: fireShadow0 }}
        decoding="async"
      />

      <div
        class="links"
        style={`
          --button-width: ${buttonWidth}px;
          --button-height: ${buttonHeight}px;
          --button-gap: ${buttonGap}px;
          --surface-height: ${surfaceHeight}px;
          --icon-margin: ${iconMargin}px;
          filter: ${fireShadow0};
        `}
      >
        <!-- BG1 partagé par tous les boutons -->
        <div class="button-surface">
          <svg
            viewBox={`0 0 ${buttonWidth} ${surfaceHeight}`}
            width={buttonWidth}
            height={surfaceHeight}
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <defs>
              <mask
                id="buttonMask"
                maskUnits="userSpaceOnUse"
                maskContentUnits="userSpaceOnUse"
                mask-type="alpha"
                x="0"
                y="0"
                width={buttonWidth}
                height={surfaceHeight}
              >
                <rect
                  x="0"
                  y="0"
                  width={buttonWidth}
                  height={surfaceHeight}
                  fill="black"
                  fill-opacity="0"
                />

                {enabledLinks.map((_, index) => (
                  <rect
                    x="0"
                    y={index * (buttonHeight + buttonGap)}
                    width={buttonWidth}
                    height={buttonHeight}
                    rx="10"
                    fill="white"
                  />
                ))}
              </mask>
            </defs>

            <!-- Fond de secours visible avant le chargement de BG1 -->
            {enabledLinks.map((_, index) => (
              <rect
                x="0"
                y={index * (buttonHeight + buttonGap)}
                width={buttonWidth}
                height={buttonHeight}
                rx="10"
                fill="#180808"
              />
            ))}

            <image
              href="/bg1.png"
              x="0"
              y="0"
              width={buttonWidth}
              height={backgroundHeight}
              preserveAspectRatio="xMidYMid slice"
              mask="url(#buttonMask)"
            />
          </svg>
        </div>

        {enabledLinks.map((link) => (
          <a href={link.url}>
            <div class="icon-container">
              <SocialIcon name={link.name} />
            </div>

            <span>{link.name}</span>
          </a>
        ))}
      </div>

      <!-- Lecteur SoundCloud visible -->
      <div class="soundcloud-player">
        <iframe
          id="soundcloud-player"
          title="Psykoruptor — Premier concert Black Out"
          src="https://w.soundcloud.com/player/?url=https%3A%2F%2Fsoundcloud.com%2Fpsykoruptor%2F1er-concert-black-out-16-10&auto_play=true&hide_related=true&show_comments=false&show_user=true&show_reposts=false&visual=false"
          width="300"
          height="166"
          allow="autoplay"
          scrolling="no"
          frameborder="no"
        ></iframe>
      </div>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
  }

  main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 24px 0;
    box-sizing: border-box;

    /* Fond de la page */
    background-color: #100000;
    background-image: url("/bg0.png");
    background-size: cover;
    background-position: center;

    /* Rotation de teinte appliquée après les ombres et le contenu */
    animation: rotateHue 20s linear infinite;
  }

  @keyframes rotateHue {
    from {
      filter: hue-rotate(0deg);
    }

    to {
      filter: hue-rotate(360deg);
    }
  }

  .logo {
    width: 300px;
    max-width: calc(100vw - 40px);
    height: auto;
    margin-bottom: 30px;
  }

  .links {
    position: relative;
    width: var(--button-width);
    max-width: calc(100vw - 40px);

    display: flex;
    flex-direction: column;
    gap: var(--button-gap);
  }

  .button-surface {
    position: absolute;
    top: 0;
    left: 0;

    width: var(--button-width);
    height: var(--surface-height);

    overflow: hidden;
    pointer-events: none;
  }

  .button-surface svg {
    display: block;

    width: var(--button-width);
    height: var(--surface-height);
  }

  .links a {
    position: relative;
    z-index: 1;

    width: var(--button-width);
    max-width: 100%;
    height: var(--button-height);

    box-sizing: border-box;
    background: transparent;

    color: white;
    text-decoration: none;

    border-radius: 10px;
  }

  /*
    L'icône est placée avec exactement la même marge
    en haut et à gauche.
  */
  .icon-container {
    position: absolute;

    left: var(--icon-margin);
    top: var(--icon-margin);

    width: 24px;
    height: 24px;

    filter: var(--fire-shadow-1);
  }

  /*
    Le texte reste centré sur le bouton entier,
    indépendamment de la position de l'icône.
  */
  .links a span {
    position: absolute;

    left: 0;
    right: 0;
    top: 50%;

    transform: translateY(-50%);

    text-align: center;

    filter: var(--fire-shadow-1);

    pointer-events: none;
  }

  .soundcloud-player {
    width: 300px;
    max-width: calc(100vw - 40px);
    margin-top: 50px;
    border-radius: 10px;
    overflow: hidden;
  }

  .soundcloud-player iframe {
    display: block;
    width: 100%;
    height: 166px;
    border: 0;
  }
</style>

<script is:inline>
  (() => {
    const startPosition = 17 * 60 * 1000;

    function initializeSoundCloud() {
      const iframe = document.getElementById("soundcloud-player");

      if (!iframe || !window.SC || !window.SC.Widget) return;

      const widget = window.SC.Widget(iframe);

      widget.bind(window.SC.Widget.Events.READY, () => {
        widget.seekTo(startPosition);
      });
    }

    let attempts = 0;

    function waitForSoundCloud() {
      if (window.SC && window.SC.Widget) {
        initializeSoundCloud();
        return;
      }

      attempts += 1;

      if (attempts < 40) {
        window.setTimeout(waitForSoundCloud, 250);
      }
    }

    waitForSoundCloud();
  })();
</script>
