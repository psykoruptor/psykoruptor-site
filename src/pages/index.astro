---
import SocialIcon from "../components/SocialIcon.astro";
import {
  links,
  buttonWidth,
  buttonHeight,
  buttonGap,
} from "../config/links";

const enabledLinks = links.filter((link) => link.enabled);

/*
  Hauteur totale réellement occupée par les boutons.
*/
const surfaceHeight =
  enabledLinks.length * buttonHeight +
  Math.max(enabledLinks.length - 1, 0) * buttonGap;

/*
  bg1.png est basé sur la version originale :
  300 × 468 px.

  On garde cette surface fixe pour que l'image ne se
  recadre pas différemment quand le nombre de liens change.
*/
const backgroundWidth = 300;
const backgroundHeight = 468;
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Psykoruptor — Links</title>
  </head>

  <body>
    <main>
      <img class="logo" src="/logotext1.png" alt="Psykoruptor" />

      <div
        class="links"
        style={`
          --button-width: ${buttonWidth}px;
          --button-height: ${buttonHeight}px;
          --button-gap: ${buttonGap}px;
          --surface-height: ${surfaceHeight}px;
        `}
      >

        <!--
          BG1 partagé par tous les boutons.

          Le SVG conserve toujours les dimensions originales
          de l'image. Il est simplement coupé en bas lorsque
          moins de boutons sont affichés.

          Ainsi, retirer un lien ne change pas le cadrage de bg1.
        -->
        <div class="button-surface">
          <svg
            viewBox={`0 0 ${backgroundWidth} ${backgroundHeight}`}
            width={backgroundWidth}
            height={backgroundHeight}
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <defs>
              <mask id="buttonMask" maskUnits="userSpaceOnUse">
                <rect
                  width={backgroundWidth}
                  height={backgroundHeight}
                  fill="black"
                />

                {enabledLinks.map((_, index) => (
                  <rect
                    x="0"
                    y={index * (buttonHeight + buttonGap)}
                    width={buttonWidth}
                    height={buttonHeight}
                    rx="10"
                    fill="white"
                  />
                ))}
              </mask>
            </defs>

            <image
              href="/bg1.png"
              x="0"
              y="0"
              width={backgroundWidth}
              height={backgroundHeight}
              preserveAspectRatio="xMidYMid slice"
              mask="url(#buttonMask)"
            />
          </svg>
        </div>

        {enabledLinks.map((link) => (
          <a href={link.url}>
            <SocialIcon name={link.name} />
            <span>{link.name}</span>
          </a>
        ))}

      </div>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100vh;
    background-image: url("/bg0.png");
    background-size: cover;
    background-position: center;
  }

  main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .logo {
    width: 300px;
    height: auto;
    margin-bottom: 30px;
    filter:
      drop-shadow(0px -0.5px 0.5px white)
      drop-shadow(0px -2px 1.5px white)
      drop-shadow(0px 1px 1px black)
      drop-shadow(0px 2px 3px black)
      drop-shadow(0px 3px 3px black);
  }

  .links {
    position: relative;

    width: var(--button-width);

    display: flex;
    flex-direction: column;
    gap: var(--button-gap);
  }

  /*
    Le SVG garde toujours la taille originale de bg1.

    Le conteneur, lui, est seulement aussi haut que les
    boutons actuellement activés.
  */
  .button-surface {
    position: absolute;
    top: 0;
    left: 0;

    width: var(--button-width);
    height: var(--surface-height);

    overflow: hidden;

    pointer-events: none;

    filter: drop-shadow(0px 4px 7px rgba(0, 0, 0, 0.7));
  }

  .button-surface svg {
    display: block;

    width: var(--button-width);
    height: 468px;
  }

  .links a {
    position: relative;
    z-index: 1;

    display: grid;
    grid-template-columns: 24px 1fr 24px;
    align-items: center;

    width: var(--button-width);
    height: var(--button-height);
    padding: 0 15px;
    box-sizing: border-box;

    background: transparent;

    color: white;
    text-decoration: none;

    border-radius: 10px;
  }

  .links a span {
    text-align: center;

    filter:
      drop-shadow(0px -2px 2px white)
      drop-shadow(0px 2px 2px black);
  }
</style>