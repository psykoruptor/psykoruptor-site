---
import SocialIcon from "../components/SocialIcon.astro";
import {
  links,
  buttonWidth,
  buttonHeight,
  buttonGap,
  iconMargin,
} from "../config/links";

const enabledLinks = links.filter((link) => link.enabled);

const surfaceHeight =
  enabledLinks.length * buttonHeight +
  Math.max(enabledLinks.length - 1, 0) * buttonGap;

const backgroundWidth = 300;
const backgroundHeight = 468;
---

<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Psykoruptor — Links</title>
	<link rel="icon" type="image/png" href="/icon0.png" />
  </head>

  <body>
    <main>
      <img class="logo" src="/logotext1.png" alt="Psykoruptor" />

      <div
        class="links"
        style={`
          --button-width: ${buttonWidth}px;
          --button-height: ${buttonHeight}px;
          --button-gap: ${buttonGap}px;
          --surface-height: ${surfaceHeight}px;
          --icon-margin: ${iconMargin}px;
        `}
      >

        <!-- BG1 partagé par tous les boutons -->
        <div class="button-surface">
          <svg
            viewBox={`0 0 ${buttonWidth} ${backgroundHeight}`}
            width={buttonWidth}
            height={backgroundHeight}
            preserveAspectRatio="none"
            aria-hidden="true"
          >
            <defs>
              <mask id="buttonMask" maskUnits="userSpaceOnUse">
                <rect
                  x="0"
                  y="0"
                  width={buttonWidth}
                  height={backgroundHeight}
                  fill="black"
                />

                {enabledLinks.map((_, index) => (
                  <rect
                    x="0"
                    y={index * (buttonHeight + buttonGap)}
                    width={buttonWidth}
                    height={buttonHeight}
                    rx="10"
                    fill="white"
                  />
                ))}
              </mask>
            </defs>

            <image
              href="/bg1.png"
              x="0"
              y="0"
              width={buttonWidth}
              height={backgroundHeight}
              preserveAspectRatio="xMidYMid slice"
              mask="url(#buttonMask)"
            />
          </svg>
        </div>

        {enabledLinks.map((link) => (
          <a href={link.url}>
            <div class="icon-container">
              <SocialIcon name={link.name} />
            </div>

            <span>{link.name}</span>
          </a>
        ))}

      </div>
    </main>
  </body>
</html>

<style>
  body {
    margin: 0;
    min-height: 100vh;
    background-image: url("/bg0.png");
    background-size: cover;
    background-position: center;
  }

  main {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .logo {
    width: 300px;
    height: auto;
    margin-bottom: 30px;
    filter:
      drop-shadow(0px -0.5px 0.5px white)
      drop-shadow(0px -2px 1.5px white)
      drop-shadow(0px 1px 1px black)
      drop-shadow(0px 2px 3px black);
  }

  .links {
    position: relative;
    width: var(--button-width);

    display: flex;
    flex-direction: column;
    gap: var(--button-gap);
  }

  .button-surface {
    position: absolute;
    top: 0;
    left: 0;

    width: var(--button-width);
    height: var(--surface-height);

    overflow: hidden;
    pointer-events: none;

    filter: drop-shadow(0px 4px 7px rgba(0, 0, 0, 0.7));
  }

  .button-surface svg {
    display: block;

    width: var(--button-width);
    height: 468px;
  }

  .links a {
    position: relative;
    z-index: 1;

    width: var(--button-width);
    height: var(--button-height);

    box-sizing: border-box;

    background: transparent;

    color: white;
    text-decoration: none;

    border-radius: 10px;
  }

  /*
    L'icône est placée avec exactement la même marge
    en haut et à gauche.
  */
  .icon-container {
    position: absolute;

    left: var(--icon-margin);
    top: var(--icon-margin);

    width: 24px;
    height: 24px;
  }

  /*
    Le texte reste centré sur le bouton entier,
    indépendamment de la position de l'icône.
  */
  .links a span {
    position: absolute;

    left: 0;
    right: 0;
    top: 50%;

    transform: translateY(-50%);

    text-align: center;

    filter:
      drop-shadow(0px -2px 2px white)
      drop-shadow(0px 2px 2px black);

    pointer-events: none;
  }
</style>